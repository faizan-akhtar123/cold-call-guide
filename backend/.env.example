# Copy to .env for local runs. On Render, set these under Environment.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
# Comma separated list of allowed frontend origins, for example your Vercel URL
ALLOWED_ORIGINS=http://localhost:5500,https://your-app.vercel.app
PORT=3000
